# WhatsApp SaaS — environment template.
# Copy to .env and fill in. Never commit the result.
# `deploy/install.sh` will generate the secrets for you.

# --- Public identity --------------------------------------------------------
# Hostname Traefik routes on and Let's Encrypt issues for. Must already
# resolve to this server. `deploy/install.sh <domain>` derives it as
# app.<domain>; nothing else in the stack hard-codes a host.
APP_HOST=app.example.com
# The registrable domain APP_HOST sits under. Only used for defaults
# (admin@, noreply@); routing is driven entirely by APP_HOST.
APP_DOMAIN=example.com
APP_NAME=WhatsApp SaaS

# Namespaces the Docker network, the volumes and the Traefik router, so two
# deployments on one host cannot collide. Must be lowercase alphanumeric/dash
# (no dots). Leave unset to keep the legacy `whatsapp-saas-*` names — changing
# it after the first boot orphans the database volume.
STACK_NAME=app-example-com
COMPOSE_PROJECT_NAME=app-example-com

# --- Secrets (generate, do not invent) --------------------------------------
# Internal shared secret between the frontend and backend containers — NOT an
# external API key (an OpenAI key does not go here; that is set in the admin
# dashboard). The backend refuses to boot without it.
# openssl rand -hex 32
BACKEND_API_KEY=
# openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

MYSQL_DATABASE=whatsapp_saas
MYSQL_USER=wa_app

# --- Bootstrap admin --------------------------------------------------------
# Created on first boot only. Changing the password here later does NOT reset
# an existing account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Behaviour --------------------------------------------------------------
# There is no ALLOW_REGISTRATION. This instance is invite-only: an admin creates
# tenants on /admin/tenants.php, and there is no public sign-up to switch on.
# Set false only when serving over plain HTTP locally, or the session cookie
# will not be sent and login will appear to silently fail.
SESSION_SECURE=true
DEV_MODE=false
# Plan every new tenant is put on. Must match a `code` in the plans table — the
# seeded ones are free / starter / business. A code that matches nothing leaves
# new tenants with no plan at all.
DEFAULT_PLAN_CODE=free
LOG_LEVEL=info
# Backend container memory ceiling and the Node heap cap inside it.
BACKEND_MEM_LIMIT=1536m
BACKEND_HEAP_MB=1024
# Media caching: attachments above this size (or in groups) are fetched on
# first view instead of being cached eagerly.
MEDIA_EAGER_MAX_BYTES=5242880
MEDIA_EAGER_GROUPS=false
# Cached media housekeeping: delete files older than this many days (0 deletes
# the whole cache on each sweep) and cap each customer's cache at this size.
MEDIA_RETENTION_DAYS=30
MEDIA_TENANT_CAP_MB=2048
# Message history held in memory per chat (disk always keeps up to 5000) and
# how long an untouched chat stays resident.
MAX_MESSAGES_IN_MEMORY=200
MESSAGE_IDLE_EVICT_MS=1800000
# From address on every email sent, and the address shown to tenants when
# something needs a human. Delivery itself goes through the SMTP server
# configured in Admin > Email, not through this host.
MAIL_FROM=

# --- Images -----------------------------------------------------------------
FRONTEND_IMAGE=ghcr.io/shahzad11/whatsapp-saas-frontend:latest
BACKEND_IMAGE=ghcr.io/shahzad11/whatsapp-saas-backend:latest

# --- Secrets at rest --------------------------------------------------------
# Key used to encrypt secrets stored in the database: the SMTP password, and
# every LLM provider API key (yours and any a tenant supplies).
# openssl rand -hex 32
# If unset, BACKEND_API_KEY is used instead. Rotating whichever one applies
# makes every already-stored secret undecryptable — the admin is prompted to
# re-enter them, nothing breaks silently, but they are gone. On a live instance
# treat both as permanent.
APP_SECRET_KEY=

# --- FenLLM -----------------------------------------------------------------
# Partner secret used once at first boot to open a free FenLLM trial account
# for the admin, whose key becomes the instance's default chat model.
# Optional: leave unset and no account is created — FenLLM is still usable by
# pasting a key into Admin > AI / LLM.
FENLLM_PARTNER_SECRET=
