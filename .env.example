# WhatsApp SaaS — environment template.
# Copy to .env and fill in. Never commit the result.
# `deploy/install.sh` will generate the secrets for you.

# --- Public identity --------------------------------------------------------
# Hostname Traefik routes on and Let's Encrypt issues for. Must already
# resolve to this server.
APP_HOST=srv1931558.hstgr.cloud
APP_NAME=WhatsApp SaaS

# --- Secrets (generate, do not invent) --------------------------------------
# openssl rand -hex 32
BACKEND_API_KEY=
# openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

MYSQL_DATABASE=whatsapp_saas
MYSQL_USER=wa_app

# --- Bootstrap admin --------------------------------------------------------
# Created on first boot only. Changing the password here later does NOT reset
# an existing account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Behaviour --------------------------------------------------------------
# Open signup. Leave false unless you actually want public registration.
ALLOW_REGISTRATION=false
# Set false only when serving over plain HTTP locally, or the session cookie
# will not be sent and login will appear to silently fail.
SESSION_SECURE=true
DEV_MODE=false
DEFAULT_PLAN_CODE=free
LOG_LEVEL=info
MAIL_FROM=

# --- Images -----------------------------------------------------------------
FRONTEND_IMAGE=ghcr.io/shahzad11/whatsapp-saas-frontend:latest
BACKEND_IMAGE=ghcr.io/shahzad11/whatsapp-saas-backend:latest
